{
  "name": "otto-cua",
  "version": "0.1.0-alpha.4",
  "private": true,
  "description": "An open-source macOS and Windows computer-use agent powered by TypeSafe Jev.",
  "type": "module",
  "license": "MIT",
  "author": "Otto contributors",
  "main": "dist-desktop/desktop/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "dev:web": "vite --host 127.0.0.1",
    "build:native": "node scripts/build-native.mjs",
    "build": "npm run build:native && vite build && tsc -p tsconfig.desktop.json",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json --noEmit && tsc -p tsconfig.evals.json",
    "test": "tsx --test core/*.test.ts desktop/*.test.ts tests/ui/*.test.ts scripts/*.test.mjs evals/*.test.ts",
    "test:ui": "electron tests/ui/fixture.cjs",
    "benchmark:context": "tsx scripts/benchmark-context.ts",
    "dev:tools": "node dist-desktop/desktop/developer-server.js",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run build && electron-builder --publish never",
    "demo:form": "tsx scripts/launch-form-fixture.ts",
    "test:batch-native": "tsx tests/native/batch-smoke.ts",
    "dev:agent": "node dist-desktop/desktop/agent-server.js",
    "setup:codex": "node scripts/install-codex.mjs",
    "test:agent-native": "tsx tests/native/agent-bridge-smoke.ts",
    "eval:codex": "tsx tests/native/codex-agent-bridge-eval.ts",
    "otto:task": "node scripts/otto-task.mjs",
    "eval:native-contracts": "tsx tests/native/contract-suite.ts",
    "eval:replay": "tsx evals/replay.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tesseract.js-data/eng": "1.0.0",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "js-tiktoken": "1.0.21",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "vite": "8.3.0"
  }
}
