{
  "name": "otto-cua",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "An open-source macOS and Windows computer-use agent powered by TypeSafe Jev.",
  "type": "module",
  "license": "MIT",
  "author": "Otto contributors",
  "main": "dist-desktop/desktop/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "dev:web": "vite --host 127.0.0.1",
    "build:native": "node scripts/build-native.mjs",
    "build": "npm run build:native && vite build && tsc -p tsconfig.desktop.json",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json --noEmit",
    "test": "tsx --test core/*.test.ts desktop/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "vite": "8.3.0"
  }
}
